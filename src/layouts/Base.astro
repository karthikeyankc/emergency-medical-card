---
/**
 * Page shell. The head carries what search engines and answer engines
 * need: a plain title and description, Open Graph and Twitter cards, a
 * canonical URL when SITE_URL is set at build time, the web manifest,
 * and any JSON-LD the page passes in.
 */
import '../styles/app.css';
import { csp } from '../headers.js';
import { href } from '../paths.js';
const { title, description, path = '/', jsonLd = [], noindex = false } = Astro.props;
const site = import.meta.env.SITE_URL || (Astro.site ? String(Astro.site).replace(/\/$/, '') : '');
const canonical = site ? `${site}${href(path)}` : null;
const image = `${site}${href('/og.png')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E1011" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Emergency Medical Card" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="An example emergency medical card, a free medical ID card sized for a wallet." />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
