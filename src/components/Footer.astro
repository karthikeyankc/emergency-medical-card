---
/**
 * Site footer, one centred column. What the tool is and who made it, the
 * links in a row, and the three notices in one quiet row underneath. Same words
 * on every page. The full terms live on the terms page.
 */
import ui from '../data/i18n/ui/en.json';
import { Stethoscope, ShieldCheck, Scale } from '@lucide/astro';
import { href } from '../paths.js';
const t = ui.footer;
const repo = 'https://github.com/KarthikeyanKC/emergency-medical-card';
---
<footer class="site-footer">
  <div class="max-w-[1400px] mx-auto px-6 py-10 flex flex-col items-center gap-6 text-center">
    <div class="space-y-3 max-w-[60ch]">
      <a href={href('/')} class="inline-flex items-center gap-3 no-underline">
        <img src={href('/logo.svg')} alt="" width="40" height="25" />
        <span class="font-bold text-(--t1)">{ui.title}</span>
      </a>
      <p>{t.about}</p>
      <p class="text-sm">{t.madeBy} <a href="https://github.com/KarthikeyanKC" rel="noopener noreferrer me" target="_blank">Karthikeyan KC</a>.</p>
    </div>
    <nav aria-label="Footer">
      <ul class="footer-links">
        <li><a href={href('/privacy')}>{t.privacyLink}</a></li>
        <li><a href={href('/terms')}>{t.termsLink}</a></li>
        <li><a href={repo} rel="noopener noreferrer" target="_blank">{t.source}</a></li>
        <li><a href={`${repo}/issues`} rel="noopener noreferrer" target="_blank">{t.report}</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-(--bds)">
    <div class="max-w-[1400px] mx-auto px-6 py-5 space-y-3">
      <ul class="footer-notices">
        <li><Stethoscope aria-hidden="true" />{t.notAdvice}</li>
        <li><ShieldCheck aria-hidden="true" />{t.privacy}</li>
        <li><Scale aria-hidden="true" />{t.liability}</li>
      </ul>
      <p class="text-sm text-center">{t.credits}</p>
    </div>
  </div>
</footer>
